{
  "name": "medical-transport-operations-analytics",
  "version": "1.0.0",
  "description": "وصل — Medical Transport Operations Analytics Platform",
  "scripts": {
    "dev": "node server.js",
    "build": "echo 'Build complete'",
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "quality:fast": "jest --runInBand --bail",
    "quality:full": "jest --runInBand --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
