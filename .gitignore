# ═══════════════════════════════════════════════
# Wasl Platform — .gitignore
# ═══════════════════════════════════════════════

# ── OS Files ──────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor Files ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig

# ── Node.js ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.npm

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# ── Environment & Secrets ─────────────────────
.env
.env.local
.env.*.local
*.env
secrets.json
config.json
config.local.js
webhook-config.json

# ── Build Outputs ─────────────────────────────
dist/
build/
out/
.cache/
.parcel-cache/

# ── Logs ──────────────────────────────────────
logs/
*.log
lerna-debug.log*

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/
.jest-cache/

# ── Temporary Files ───────────────────────────
tmp/
temp/
*.tmp
*.temp

# ── Generated Outputs ─────────────────────────
wasl_report.html
data.json

# ── Large Data Files (do not commit real data) ─
# Uncomment if you need to exclude sensitive data files:
# *.xlsx
# *.csv
# *.json (except package.json and manifest.json)

# ── Screenshots with PII ──────────────────────
# Add specific screenshot files containing patient data here
# patient-data-*.png

# ── Local Development Config ──────────────────
.local/
local.config.js
